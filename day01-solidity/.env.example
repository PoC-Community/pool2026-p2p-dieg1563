# Sepolia RPC URL - Public node (free)
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Your private key (NEVER commit this to git!)
# Get from MetaMask: Menu → Account details → Show private key
# WARNING: Keep this secret! Anyone with this key can access your funds!
PRIVATE_KEY=your_private_key_here_without_0x_prefix

# Optional: Etherscan API Key for automatic verification
# Get free API key from: https://etherscan.io/myapikey
# If you don't have one, omit the --verify flag when deploying
ETHERSCAN_API_KEY=your_etherscan_api_key_here
